# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
Icon?

# ---- Xcode: user state & build output ----
# Per-user UI state and schemes management (churns constantly, not shared).
*.xcuserstate
**/xcuserdata/
# Build products and Xcode's derived data, plus this repo's local build dir.
build/
DerivedData/
DerivedDataTmp/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager ----
.build/
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# ---- Tooling / local config ----
# XcodeBuildMCP scratch.
.xcodebuildmcp/
# Claude local-only settings (skills themselves stay versioned).
.claude/settings.local.json

# ---- Supabase ----
# Local CLI link/temp state (project ref, not secrets). Regenerated by `supabase link`.
server/supabase/.temp/
# Root-level state created when the CLI is run from the repository root.
supabase/.temp/
# Stray nested CLI state from running `supabase init` inside server/supabase.
server/supabase/supabase/
# Never commit function secrets if a local env file is ever added.
server/supabase/functions/**/.env
**/.env
**/.env.*

# ---- Heavy scratch media at the wrapper root ----
# Simulator/screen recordings and loose screenshots. NOT app resources
# (those live under "Aura iOS/.../Resources" and Assets.xcassets and stay tracked).
/axe-video-*.mp4
/n1r.png

# Local agent state and distribution credentials
/.agents/
/.claude/
/.codex/
*.xcarchive/
*.p12
*.p8
*.mobileprovision
*.cer
*.key
